e-flex e-con e-child\" data-id=\"35d23b9a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-6bce2b2d elementor-widget elementor-widget-text-editor\" data-id=\"6bce2b2d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"d-grid py-2\"><p><strong>Neden IBC4500 IBC Yağ Sistemi Makaralı ?</strong></p><p>IBC yağ sistemlerini, yüksek kapasiteli yağ ihtiyacı olan işletmelerin işini kolaylaştırmak için tasarladık. Sistemde farklı kombinasyonlar kullanabilirsiniz; sayaçlı veya sayaçsız yağ tabancaları, 10-15-20 metre hortum sarma kapasiteli makaralar ve farklı verimlerde havalı pompalar seçebilirsiniz.</p><p><a href=\"https://www.gulersan.com/wp-content/uploads/2021/01/IBC4500.jpg\"><img fetchpriority=\"high\" decoding=\"async\" class=\"wp-post-image ux-skip-lazy aligncenter\" src=\"https://www.gulersan.com/wp-content/uploads/2021/01/IBC4500.jpg\" alt=\"IBC Yağ Sistemi Makaralı IBC4500. IBC tanklardan yağ transferi için makaralı, yüksek basınçlı havalı pompa sistemi, hortum makarası ile düzenli ve verimli toplu yağ dağıtımı.\" width=\"497\" height=\"496\" data-caption=\"IBC (Intermediate Bulk Container) tanklarından toplu yağ transferi ve dağıtımı için tasarlanmış, hortum makarasına (reel) sahip yüksek basınçlı havalı (pnömatik) yağ pompası içeren komple bir dağıtım sistemi; makara sayesinde düzenli, güvenli ve verimli bir kullanım sunar, endüstriyel tesislerdeki ve büyük atölyelerdeki yüksek hacimli yağ ihtiyaçları için idealdir, IBC4500 modelini referans alır.\" data-src=\"https://www.gulersan.com/wp-content/uploads/2021/01/IBC4500.jpg\" data-large_image=\"https://www.gulersan.com/wp-content/uploads/2021/01/IBC4500.jpg\" data-large_image_width=\"497\" data-large_image_height=\"496\" /></a></p></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-30ffce0 elementor-widget elementor-widget-text-editor\" data-id=\"30ffce0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"d-grid py-2\"><h4>Teslimat Kapsamı</h4><div class=\"table-responsive wprt_style_display\"><table class=\"table\" bgcolor=\"white\"><tbody><tr><td colspan=\"4\" bgcolor=\"white\"><img decoding=\"async\" class=\"alignnone wp-image-4888\" src=\"https://www.gulersan.com/wp-content/uploads/2020/12/cizgi.jpg\" sizes=\"(max-width: 1454px) 100vw, 1454px\" srcset=\"https://www.gulersan.com/wp-content/uploads/2020/12/cizgi.jpg 606w, https://www.gulersan.com/wp-content/uploads/2020/12/cizgi-510x4.jpg 510w\" alt=\"\" width=\"1454\" height=\"12\" /></td></tr><tr><td><strong>       Havalı Yağ Pompası 3045</strong></td><td> </td><td><img decoding=\"async\" class=\"alignnone wp-image-9022\" src=\"https://www.gulersan.com/wp-content/uploads/2020/12/3045_havali_ince_yag_pompasi_duvar_tipi15lt-1.jpg\" alt=\"\" width=\"63\" height=\"63\" />   </td></tr><tr><td><strong>       Dijital Sayaçlı Yağ Tabancası 4106</strong></td><td> </td><td><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-5849\" src=\"https://www.gulersan.com/wp-content/uploads/2021/01/4106.png\" alt=\"\" width=\"62\" height=\"62\" />     </td></tr><tr><td><strong>       Yağ Hortum Makarası 10 Mt. 4500N.1038</strong></td><td> </td><td><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-5853\" src=\"https://www.gulersan.com/wp-content/uploads/2021/01/ince-yag-hortum-makarasi-kasasiz.jpg\" sizes=\"auto, (max-width: 66px) 100vw, 66px\" srcset=\"https://www.gulersan.com/wp-content/uploads/2021/01/ince-yag-hortum-makarasi-kasasiz.jpg 500w, https://www.gulersan.com/wp-content/uploads/2021/01/ince-yag-hortum-makarasi-kasasiz-100x100.jpg 100w, https://www.gulersan.com/wp-content/uploads/2021/01/ince-yag-hortum-makarasi-kasasiz-400x400.jpg 400w, https://www.gulersan.com/wp-content/uploads/2021/01/ince-yag-hortum-makarasi-kasasiz-280x280.jpg 280w, https://www.gulersan.com/wp-content/uploads/2021/01/ince-yag-hortum-makarasi-kasasiz-247x247.jpg 247w\" alt=\"\" width=\"66\" height=\"66\" />    </td></tr><tr><td><strong>       Damlalık 7160</strong></td><td> </td><td><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-5851\" src=\"https://www.gulersan.com/wp-content/uploads/2021/01/7110_damlalik-1-1.jpg\" alt=\"\" width=\"60\" height=\"60\" />    </td></tr><tr><td><strong>       Hortum 1 Mt. x 2 ( Pompa ve IBC bağlantı )</strong></td><td> </td><td><img loading=\"lazy\" decoding=\"async\" class=\"alignnone wp-image-8740\" src=\"https://www.gulersan.com/wp-content/uploads/2021/01/greshortumu.png\" alt=\"\" width=\"80\" height=\"40\" />      </td></tr><tr><td height=\"65px\"><strong>       Garanti</strong></td><td> </td><td>36 Ay       </td></tr><tr><td height=\"65px\"><strong>       Koli Ölçüleri</strong></td><td> </td><td>20x70x113 Cm</td></tr></tbody></table></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-299c2533 e-con-full e-flex e-con e-child\" data-id=\"299c2533\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-e21545e e-con-full e-flex e-con e-child\" data-id=\"e21545e\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-0d09eaf elementor-widget elementor-widget-heading\" data-id=\"0d09eaf\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Fiyat Teklifi Alın</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-ele