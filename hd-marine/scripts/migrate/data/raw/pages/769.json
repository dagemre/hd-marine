nt elementor-element-1dbe967 elementor-widget elementor-widget-text-editor\" data-id=\"1dbe967\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<table width=\"514\"><tbody><tr><td width=\"185\">Özellik</td><td width=\"329\">Değer</td></tr><tr><td width=\"185\">Ürün Tipi</td><td width=\"329\">Spiral Sarımlı Çelik Conta</td></tr><tr><td width=\"185\">Malzeme</td><td width=\"329\">AISI 304 / AISI 316 Çelik</td></tr><tr><td width=\"185\">Dolgu Malzemesi</td><td width=\"329\">Elastomer / Grafit</td></tr><tr><td width=\"185\">Uygulama</td><td width=\"329\">Flanş ve boru bağlantısı sızdırmazlığı</td></tr><tr><td width=\"185\">Maksimum Basınç</td><td width=\"329\">≤ 250 bar (model özel)</td></tr><tr><td width=\"185\">Sıcaklık Aralığı</td><td width=\"329\">-200°C – +540°C</td></tr><tr><td width=\"185\">Yüzey Uygunluğu</td><td width=\"329\">Düz / Dalgalı / Spiral yüzey</td></tr><tr><td width=\"185\">Kalınlık</td><td width=\"329\">3 – 6 mm</td></tr></tbody></table>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-321f423 e-flex e-con-boxed e-con e-child\" data-id=\"321f423\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-9e79ffa e-con-full e-flex e-con e-child\" data-id=\"9e79ffa\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-53514bf e-flex e-con-boxed e-con e-child\" data-id=\"53514bf\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a6a70de elementor-widget elementor-widget-heading\" data-id=\"a6a70de\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_ty