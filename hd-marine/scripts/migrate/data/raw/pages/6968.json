dmarine.com.tr/wp-content/uploads/2025/11/J-90-Airless-Tabanca-150x150.jpg 150w, https://hdmarine.com.tr/wp-content/uploads/2025/11/J-90-Airless-Tabanca-300x300.jpg 300w, https://hdmarine.com.tr/wp-content/uploads/2025/11/J-90-Airless-Tabanca-100x100.jpg 100w, https://hdmarine.com.tr/wp-content/uploads/2025/11/J-90-Airless-Tabanca.jpg 500w\" sizes=\"100vw\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-2b2a6ab e-con-full e-flex e-con e-child\" data-id=\"2b2a6ab\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-22d08c6 e-con-full e-flex e-con e-child\" data-id=\"22d08c6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-966c864 elementor-widget elementor-widget-text-editor\" data-id=\"966c864\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong>Boya tabancaları</strong>, boya veya kaplama malzemesini yüzeye püskürtmek için kullanılan profesyonel el aletleridir. Farklı tipleriyle (airless, HVLP, klasik püskürtme vb.) boya tabancaları, hem büyük yüzeylerde hem de detaylı işleri hızlı, eşit ve ekonomik bir şekilde yapmanızı sağlar.</p><p>HD Marine boya tabancaları, marin ve endüstriyel uygulamalarda yüksek performans ve kaliteyi bir arada sunan güçlü ekipmanlardır. Bu tabancalar, hem profesyonel boya ustaları hem de teknik ekipler için idealdir.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-8b6d589 e-con-full e-flex e-con e-child\" data-id=\"8b6d589\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a275705 elementor-view-stacked elementor-position-inline-start elementor-tablet-position-inline-end elementor-shape-circle elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"a275705\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-box-wrapper\">\n\n\t\t\t\t\t\t<div class=\"elementor-icon-box-icon\">\n\t\t\t\t<span  class=\"elementor-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-table\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M464 32H48C21.49 32 0 53.49 0 80v352c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V80c0-26.51-21.49-48-48-48zM224 416H64v-96h160v96zm0-160H64v-96h160v96zm224 160H288v-96h160v96zm0-160H288v-96h160v96z\"></path></svg>\t\t\t\t</span>\n\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-icon-box-content\">\n\n\t\t\t\t\t\t\t\t\t<h3 class=\"elementor-icon-box-title\">\n\t\t\t\t\t\t<span  >\n\t\t\t\t\t\t\tBoya Tabancaları Teknik Genel Tablosu\t\t\t\t\t\t</span>\n\t\t\t\t\t</h3>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b19ee13 elementor-widget elementor-widget-text-editor\" data-id=\"b19ee13\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<table width=\"514\"><tbody><tr><td width=\"185\">Özellik</td><td width=\"329\">Değer</td></tr><tr><td width=\"185\">Ürün Tipi</td><td width=\"329\">Boya Tabancası</td></tr><tr><td width=\"185\">Çalışma Prensibi</td><td width=\"329\">Airless / HVLP / Püskürtme</td></tr><tr><td width=\"185\">Basınç Aralığı</td><td width=\"329\">50 – 300 bar (modele göre değişir)</td></tr><tr><td width=\"185\">Nozul Çapı</td><td width=\"329\">0.008” – 0.035”</td></tr><tr><td width=\"185\">Hortum Bağlantı</td><td width=\"329\">¼” – ½”</td></tr><tr><td width=\"185\">Kullanım Alanı</td><td width=\"329\">Metal, ahşap, beton, marin yüzeyler</td></tr><tr><td width=\"185\">Ağırlık</td><td width=\"329\">400 – 1200 g</td></tr><tr><td width=\"185\">Malzeme</td><td width=\"329\">Alüminyum, paslanmaz çelik parçalar</td></tr><tr><td width=\"185\">Uygulama</td><td width=\"329\">Endüstriyel ve profesyonel boya işleri</td></tr></tbody></table>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-d1accf4 e-flex e-con-boxed e-con e-child\" data-id=\"d1accf4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-fed1abc e-con-full e-flex e-con e-child\" data-id=\"fed1abc\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-f9e3da6 e-flex e-con-boxed e-con e-child\" data-id=\"f9e3da6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-c962869 elementor-widget elementor-widget-heading\" data-id=\"c962869\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Boya Tabancalarının Kullanım Alanları</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d25cc17 elementor-widget elementor-widget-text-editor\" data-id=\"d25cc17\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<ul><li>Endüstriyel tesis boya işleri</li><li>Gemi / marin yüzey boya uygulamaları</li><li>İnşaat ve dekorasyon projeleri</li><li>Metal, ahşap, beton yüzeyler</li><li>Seri üretim ve büyük boyama hatları</li></ul><p>Boya tabancaları, <strong>hızlı kaplama</strong>, <strong>eşit boya dağılımı</strong> ve <strong>daha az boya israfı</strong> gibi avantajlarla boya sürecini daha verimli hale getirir.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-69e9e96 elementor-widget elementor-widget-heading\" data-id=\"69e9e96\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Neden HD Marine Boya Tabancaları?</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0279995 elementor-widget elementor-widget-text-editor\" data-id=\"0279995\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<ul><li><p>✔ <strong>Yüksek kaplama verimliliği:</strong> Mükemmel kaplama kalitesi<br />✔ <strong>Dengeli boya akışı:</strong> Pürüzsüz ve eşit boya dağılımı<br />✔ <strong>Dayanıklı yapılar:</strong> Endüstriyel kullanım için tasarlandı<br />✔ <strong>Kolay bakım:</strong> Parça değişimi ve temizliği pratik</p></li></ul>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-f8996a7 e-con-full e-flex e-con e-child\" data-id=\"f8996a7\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-5075bc4 elementor-widget__width-inherit elementor-widget elementor-widget-elementskit-accordion\" data-id=\"5075bc4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"elementskit-accordion.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\" >\n        <div class=\"elementskit-accordion accoedion-primary\" id=\"acco