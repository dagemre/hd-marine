e-child\" data-id=\"3504fc2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-7fcd994 e-con-full e-flex e-con e-child\" data-id=\"7fcd994\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-dfe70c6 e-flex e-con-boxed e-con e-child\" data-id=\"dfe70c6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-4b91842 elementor-widget elementor-widget-heading\" data-id=\"4b91842\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Asturo K30 Airless Pompa</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-edafc10 elementor-widget elementor-widget-heading\" data-id=\"edafc10\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Airless Boya Makinaları \n- Yüksek Performanslı Boya Uygulama Çözümleri</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e328441 elementor-widget elementor-widget-image\" data-id=\"e328441\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"300\" height=\"300\" src=\"https://hdmarine.com.tr/wp-content/uploads/2025/11/ASTURO-K-30-300x300.jpg\" class=\"attachment-medium size-medium wp-image-2961\" alt=\"\" srcset=\"https://hdmarine.com.tr/wp-content/uploads/2025/11/ASTURO-K-30-300x300.jpg 300w, https://hdmarine.com.tr/wp-content/uploads/2025/11/ASTURO-K-30-150x150.jpg 150w, https://hdmarine.com.tr/wp-content/uploads/2025/11/ASTURO-K-30-100x100.jpg 100w, https://hdmarine.com.tr/wp-content/uploads/2025/11/ASTURO-K-30.jpg 500w\" sizes=\"100vw\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-dc7a959 e-flex e-con-boxed e-con e-child\" data-id=\"dc7a959\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-690bb51 e-flex e-con-boxed e-con e-child\" data-id=\"690bb51\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8f3df99 elementor-widget elementor-widget-text-editor\" data-id=\"8f3df99\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p><strong>Airless boya makineleri</strong>, hava kullanmadan boya püskürtme prensibiyle çalışan profesyonel boya ekipmanlarıdır. Bu makineler, boya veya kaplama malzemesini <strong>yüksek basınçla</strong> püskürterek geniş yüzeylerde hızlı ve eşit kaplama sağlar. “Airless” terimi, boyanın atomize edilmesi için <strong>sıkıştırılmış hava kullanılmaması</strong> anlamına gelir; bunun yerine yüksek basınçlı pompa sistemi ile boya yüzeye iletilir.</p><p>HD Marine Airless boya makineleri, endüstriyel tesislerde, inşaat ve dekorasyon projelerinde, gemi / marin bakım işlemlerinde ve büyük yüzey boya işlerinde <strong>yüksek verim ve kaliteli kaplama</strong> sağlar. Bu makineler, hem profesyonel boya uygulayıcılarının hem de teknik ekiplerin sıklıkla tercih ettiği güçlü ekipmanlardır.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-e502de1 e-con-full e-flex e-con e-child\" data-id=\"e502de1\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-db7fffc elementor-view-stacked elementor-position-inline-start elementor-tablet-position-inline-end elementor-shape-circle elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"db7fffc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-box-wrapper\">\n\n\t\t\t\t\t\t<div class=\"elementor-icon-box-icon\">\n\t\t\t\t<span  class=\"elementor-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-table\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M464 32H48C21.49 32 0 53.49 0 80v352c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V80c0-26.51-21.49-48-48-48zM224 416H64v-96h160v96zm0-160H64v-96h160v96zm224 160H288v-96h160v96zm0-160H288v-96h160v96z\"></path></svg>\t\t\t\t</span>\n\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-icon-box-content\">\n\n\t\t\t\t\t\t\t\t\t<h3 class=\"elementor-icon-box-title\">\n\t\t\t\t\t\t<span  >\n\t\t\t\t\t\t\tAirless Boya Makinası Teknik Değer Tablosu\t\t\t\t\t\t</span>\n\t\t\t\t\t</h3>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0e84c25 elementor-widget elementor-widget-text-editor\" data-id=\"0e84c25\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<table width=\"648\"><tbody><tr><td width=\"252\">Özellik</td><td width=\"396\">Değer</td></tr><tr><td width=\"252\">Çalışma Prensibi</td><td width=\"396\">Havasız (airless) püskürtme</td></tr><tr><td width=\"252\">Maksimum Basınç</td><td width=\"396\">200–300 Bar</td></tr><tr><td width=\"252\">Debi</td><td width=\"396\">1.5–6 l/dak</td></tr><tr><td width=\"252\">Motor Gücü</td><td width=\"396\">800–3000 W</td></tr><tr><td width=\"252\">Voltaj</td><td width=\"396\">220V / 380V</td></tr><tr><td width=\"252\">Emme Çapı</td><td width=\"396\">½” – 1”</td></tr><tr><td width=\"252\">Hortum Uzunluğu</td><td width=\"396\">10–30 m</td></tr><tr><td width=\"252\">Nozul Çeşitleri</td><td width=\"396\">0.015–0.035 inç</td></tr><tr><td width=\"252\">Ağırlık</td><td width=\"396\">20–60 kg</td></tr></tbody></table>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-e061af8 e-flex e-con-boxed e-con e-child\" data-id=\"e061af8\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-cdfc264 e-con-full e-flex e-con e-child\" data-id=\"cdfc264\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-9dedab0 e-flex e-con-boxed e-con e-child\" data-id=\"9dedab0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-080f5d9 elementor-widget elementor-widget-heading\" data-id=\"080f5d9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Airless Boya</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2295526 elementor-widget elementor-widget-heading\" data-id=\"2295526\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">Kullanım Alanları</h3>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2516b9f elementor-widget elementor-widget-text-editor\" data-id=\"2516b9f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Airless boya makineleri özellikle şu alanlarda kullanılır:</p><ul><li>Büyük yüzeylerin boyanması (duvar, çatı, dış cephe)</li><li>Endüstriyel boyama tesisleri</li><li>Marin ve gemi bakım uygulamaları</li><li>Metal ve çelik konstrüksiyon boyama</li><li>Zemin ve beton yüzey uygulamaları</li></ul><p>Bu makineler, <strong>hızlı kaplama, yüksek verim ve profesyonel sonuç</strong> elde etmek isteyen tüm boya uygulama süreçleri için uygundur.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-86a074a e-con-full e-flex e-con e-child\" data-id=\"86a074a\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<div class=\"elementor-element elementor-element-318e487 elementor-widget__width-inherit elementor-widget elementor-widget-elementskit-accordion\" data-id=\"318e487\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"elementskit-accordion.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<div class=\"ekit-wid-con\" >\n        <div class=\"elementskit-accordion accoedion-primary\" id=\"accordion-6a24921020728\">\n\n            \n                <div class=\"elementskit-card \">\n                    <div class=\"elementskit-card-header\" id=\"primaryHeading-0-318e487\">\n                        <a href=\"#collapse-d9bc4456a24921020728\" class=\"ekit-accordion--toggler elementskit-btn-link collapsed\" data-ekit-toggle=\"collapse\" data-target=\"#Collapse-d9bc4456a24921020728\" aria-expanded=\"false\" aria-controls=\"Collapse-d9bc4456a24921020728\">\n                            \n                            <span class=\"ekit-accordion-title\">Airless boya makinası nedir?</span>\n\n                            \n                                <div class=\"ekit_accordion_icon_group\">\n                                    <div class=\"ekit_accordion_normal_icon\">\n                                        <!-- Normal Icon -->\n\t\t\t\t\t\t\t\t\t\t<svg class=\"e-font-icon-svg e-fas-arrow-circle-down\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M504 256c0 137-111 248-248 248S8 393 8 256 119 8 256 8s248 111 248 248zm-143.6-28.9L288 302.6V120c0-13.3-10.7-24-24-24h-16c-13.3 0-24 10.7-24 24v182.6l-72.4-75.5c-9.3-9.7-24.8-9.9-34.3-.4l-10.9 11c-9.4 9.4-9.4 24.6 0 33.9L239 404.3c9.4 9.4 24.6 9.4 33.9 0l132.7-132.7c9.4-9.4 9.4-24.6 0-33.9l-10.9-11c-9.5-9.5-25-9.3-34.3.4z\"></path></svg>                                    </div>\n\n                                    <div class=\"ekit_accordion_active_icon\">\n                                        <!-- Active Icon -->\n\t\t\t\t\t\t\t\t\t\t<svg class=\"e-font-icon-svg e-fas-arrow-circle-up\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M8 256C8 119 119 8 256 8s248 111 248 248-111 248-248 248S8 393 8 256zm143.6 28.9l72.4-75.5V392c0 13.3 10.7 24 24 24h16c13.3 0 24-10.7 24-24V209.4l72.4 75.5c9.3 9.7 24.8 9.9 34.3.4l10.9-11c9.4-9.4 9.4-24.6 0-33.9L273 107.7c-9.4-9.4-24.6-9.4-33.9 0L106.3 240.4c-9.4 9.4-9.4 24.6 0 33.9l10.9 11c9.6 9.5 25.1 9.3 34.4-.4z\"></path></svg>                                    </div>\n                                </div>\n\n                            \n                                                    </a>\n                    </div>\n\n                    <div id=\"Collapse-d9bc4456a24921020728\" class=\" collapse\" aria-labelledby=\"primaryHeading-0-318e487\" data-parent=\"#accordion-6a24921020728\">\n\n                        <div class=\"elementskit-card-body ekit-accordion--content\">\n                            <p>Airless boya makinası, boyayı yüksek basınçla püskürterek yüzeye eşit ve hızlı kaplama sağlayan profesyonel boya ekipmanıdır.</p>                        </div>\n\n                    </div>\n\n                </div><!-- .elementskit-card END -->\n\n                \n                <div class=\"elementskit-card \">\n                    <div class=\"elementskit-card-header\" id=\"primaryHeading-1-318e487\">\n                        <a href=\"#collapse-f152ab46a24921020728\" class=\"ekit-accordion--toggler elementskit-btn-link collapsed\" data-ekit-toggle=\"collapse\" data-target=\"#Collapse-f152ab46a24921020728\" aria-expanded=\"false\" aria-controls=\"Collapse-f152ab46a24921020728\">\n                            \n                            <span class=\"ekit-accordion-title\">“Airless” ne anlama gelir?</span>\n\n                            \n                                <div class=\"ekit_accordion_icon_group\">\n                                    <div class=\"ekit_accordion_normal_icon\">\n                                        <!-- Normal Icon -->\n\t\t\t\t\t\t\t\t\t\t<svg class=\"e-font-icon-svg e-fas-arrow-circle-down\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M504 256c0 137-111 248-248 248S8 393 8 256 119 8 256 8s248 111 248 248zm-143.6-28.9L288 302.6V120c0-13.3-10.7-24-24-24h-16c-13.3 0-24 10.7-24 24v182.6l-72.4-75.5c-9.3-9.7-24.8-9.9-34.3-.4l-10.9 11c-9.4 9.4-9.4 24.6 0 33.9L239 404.3c9.4 9.4 24.6 9.4 33.9 0l132.7-132.7c9.4-9.4 9.4-24.6 0-33.9l-10.9-11c-9.5-9.5-25-9.3-34.3.4z\"></path></svg>                                    </div>\n\n                                    <div class=\"ekit_accordion_active_icon\">\n                                        <!-- Active Icon -->\n\t\t\t\t\t\t\t\t\t\t<svg class=\"e-font-icon-svg e-fas-arrow-circle-up\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M8 256C8 119 119 8 256 8s248 111 248 248-111 248-248 248S8 393 8 256zm143.6 28.9l72.4-75.5V392c0 13.3 10.7 24 24 24h16c13.3 0 24-10.7 24-24V209.4l72.4 75.5c9.3 9.7 24.8 9.9 34.