 e-child\" data-id=\"43085c4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-887d05a e-con-full e-flex e-con e-child\" data-id=\"887d05a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-fe49a25 elementor-widget elementor-widget-image\" data-id=\"fe49a25\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"image.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img fetchpriority=\"high\" decoding=\"async\" width=\"300\" height=\"300\" src=\"https://hdmarine.com.tr/wp-content/uploads/2025/06/SHM_PB-300x300.png\" class=\"attachment-medium size-medium wp-image-2658\" alt=\"\" srcset=\"https://hdmarine.com.tr/wp-content/uploads/2025/06/SHM_PB-300x300.png 300w, https://hdmarine.com.tr/wp-content/uploads/2025/06/SHM_PB-150x150.png 150w, https://hdmarine.com.tr/wp-content/uploads/2025/06/SHM_PB-768x768.png 768w, https://hdmarine.com.tr/wp-content/uploads/2025/06/SHM_PB-100x100.png 100w, https://hdmarine.com.tr/wp-content/uploads/2025/06/elementor/thumbs/SHM_PB-r7g9t919aurqay6gypc6kh3x4qe0pkeh7l5qv4ikjs.png 500w, https://hdmarine.com.tr/wp-content/uploads/2025/06/SHM_PB.png 780w\" sizes=\"100vw\" />\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b4a9eb2 elementor-widget elementor-widget-text-editor\" data-id=\"b4a9eb2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>Manyetik asit pompaları, <strong>asitle, kimyasallarla ve korozif sıvılarla çalışmak için özel üretilmiş manyetik kavramalı pozitif deplasmanlı pompalardır</strong>. Mekanik salmastra yerine manyetik kavrama sayesinde sızdırmazlığı maksimum seviyeye çıkarır ve <strong>kirleticilere, aşındırıcı akışkanlara karşı üstün dayanım sağlar</strong>.</p><p>HD Marine manyetik asit pompaları, özellikle <strong>laboratuvarlardan üretim hatlarına</strong>, kimya tesislerinden marin uygulamalara kadar geniş bir kullanım alanında <strong>yüksek performans ve dayanıklılık</strong> sunar.</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-38bbcb2 e-con-full e-flex e-con e-child\" data-id=\"38bbcb2\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-14ac662 elementor-view-stacked elementor-position-inline-start elementor-tablet-position-inline-end elementor-shape-circle elementor-mobile-position-block-start elementor-widget elementor-widget-icon-box\" data-id=\"14ac662\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-box.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-icon-box-wrapper\">\n\n\t\t\t\t\t\t<div class=\"elementor-icon-box-icon\">\n\t\t\t\t<span  class=\"elementor-icon\">\n\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-table\" viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M464 32H48C21.49 32 0 53.49 0 80v352c0 26.51 21.49 48 48 48h416c26.51 0 48-21.49 48-48V80c0-26.51-21.49-48-48-48zM224 416H64v-96h160v96zm0-160H64v-96h160v96zm224 160H288v-96h160v96zm0-160H288v-96h160v96z\"></path></svg>\t\t\t\t</span>\n\t\t\t</div>\n\t\t\t\n\t\t\t\t\t\t<div class=\"elementor-icon-box-content\">\n\n\t\t\t\t\t\t\t\t\t<h3 class=\"elementor-icon-box-title\">\n\t\t\t\t\t\t<span  >\n\t\t\t\t\t\t\tManyetik Asit Pompası Teknik Değer Tablosu\t\t\t\t\t\t</span>\n\t\t\t\t\t</h3>\n\t\t\t\t\n\t\t\t\t\n\t\t\t</div>\n\t\t\t\n\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d8ac01f elementor-widget elementor-widget-text-editor\" data-id=\"d8ac01f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<table width=\"514\"><tbody><tr><td width=\"185\">Özellik</td><td width=\"329\">Değer</td></tr><tr><td width=\"185\">Pompa Tipi</td><td width=\"329\">Manyetik Kavramalı Santrifüj</td></tr><tr><td width=\"185\">Debi Aralığı</td><td width=\"329\">1 – 150 m³/h</td></tr><tr><td width=\"185\">Maksimum Basınç</td><td width=\"329\">6 – 16 bar</td></tr><tr><td width=\"185\">Motor Gücü</td><td width=\"329\">0.37 – 15 kW</td></tr><tr><td width=\"185\">Gövde Malzemesi</td><td width=\"329\">PP / PVDF / ETFE</td></tr><tr><td width=\"185\">Sızdırmazlık</td><td width=\"329\">Salmastrasız Manyetik</td></tr><tr><td width=\"185\">Çalışma Sıcaklığı</td><td width=\"329\">-10°C / +120°C</td></tr><tr><td width=\"185\">Bağlantı Çapı</td><td width=\"329\">1/2” – 4”</td></tr></tbody></table>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-7680bbe e-flex e-con-boxed e-con e-child\" data-id=\"7680bbe\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-ec99fee e-con-full e-flex e-con e-child\" data-id=\"ec99fee\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-78e86e0 e-flex e-con-boxed e-con e-child\" data-id=\"78e86e0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-546d138 elementor-widget elementor-widget-heading\" data-id=\"546d138\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Kullanım Alanları</h2>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"eleme